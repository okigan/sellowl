# Copy to .env and fill in. `.env` is gitignored — never commit real keys.

# --- Apify -----------------------------------------------------------------
# https://console.apify.com/settings/integrations -> Personal API token
# Hack-night coupon for $50 platform usage: ELASTIC_APIFY_HCK_NGHT
APIFY_TOKEN=

# --- Vision ------------------------------------------------------------------
# Photo grading (condition + attributes + search queries). Without either
# provider configured the app still runs; it degrades to title-only matching.
#
# Default provider: Anthropic.
# https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
#
# Alternative provider: any OpenAI-compatible chat-completions server (a local
# vLLM/llama.cpp server with a vision model, etc.). Set VISION_PROVIDER=openai
# to use these instead of Anthropic.
VISION_PROVIDER=anthropic
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# --- Elastic ---------------------------------------------------------------
# Use the .es. endpoint, NOT the .kb. Kibana URL. This is the single most
# common setup mistake and it fails with a confusing error.
ELASTICSEARCH_ENDPOINT=
ELASTICSEARCH_API_KEY=

# --- Actors (swap without touching code if one misbehaves) -----------------
# memo23's `seller` field is a filter, not a source: store.py builds a
# seller-search startUrl for it. Verified live; crawlerbros and caffein.dev
# were tried and dropped (blocked / never returns). See docs/DEVELOP.md.
ACTOR_STORE=memo23/ebay-search-scraper-ppe
ACTOR_SOLD=memo23/ebay-search-scraper-ppe
ACTOR_LOCAL=apify/facebook-marketplace-scraper

# --- Tuning ----------------------------------------------------------------
METRO=austin
# Prefilled in the UI; any eBay store or seller URL works.
DEFAULT_STORE_URL=https://www.ebay.com/usr/pragm_14
MAX_ITEMS=12
MAX_COMPS_PER_QUERY=40
RERANK_TOP_K=8
MIN_COMPS=5
VISION_CONCURRENCY=8
# Apify free/basic accounts cap total concurrent Actor memory; keep this low
# enough that fan-out doesn't 402.
COMP_CONCURRENCY=3
# Apify runs are the slow part (minutes) and idempotent per (actor, payload);
# results are cached on disk. 0 disables. DELETE /api/cache clears it.
APIFY_CACHE_TTL_HOURS=20

# --- Fees (category-dependent approximations, not gospel) ------------------
EBAY_FVF_RATE=0.1325
EBAY_FIXED_FEE=0.40
FB_LOCAL_RATE=0.0
# A Facebook comp is an asking price, not a sold one; this haircuts it
# before it's treated as achievable proceeds.
FB_ASK_DISCOUNT=0.85

# --- Search backend --------------------------------------------------------
# "elastic" (hack-night default) or "sqlite" (self-hosted: FTS5 BM25 +
# brute-force vectors, no cluster). Same CompStore protocol either way, so
# this is the only switch needed to compare them. See docs/MIGRATION.md.
SEARCH_BACKEND=elastic
SQLITE_DB_PATH=.cache/comps.db

# Vectors for SEARCH_BACKEND=sqlite. Leave blank to use the built-in
# dependency-free hashing embedder (lexical, not semantic -- fine for tests,
# weaker for real matching).
#
# Local container:  docker compose --profile selfhosted up embeddings
#   EMBEDDING_BASE_URL=http://localhost:8080/v1
# nvbox, once it exposes /v1/embeddings (it currently proxies only
# chat/completions, messages and images):
#   EMBEDDING_BASE_URL=http://nvbox:4000/v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
